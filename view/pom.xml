-->
                                <!--<arg>-H:ReachabilityMetadataFiles=${project.basedir}/src/main/resources/config/reachability-metadata.json
                                </arg>-->

                            </nativeImageArgs>

                            <reflectionList>
                                <list>org.application.desktop.dto.CustomerDTO</list>
                                <list>org.application.desktop.MainApp</list>
                                <list>javafx.scene.Node</list>
                                <list>javafx.scene.Parent</list>
                                <list>javafx.scene.Scene</list>
                                <list>javafx.scene.control.Button</list>
                                <!-- سایر کلاس‌های JavaFX که استفاده می‌کنید -->
                                <list>com.sun.javafx.tk.quantum.QuantumRenderer</list>
                            </reflectionList>

                            <bundlesList>
