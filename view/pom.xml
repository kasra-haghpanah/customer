                    <plugin>
                        <groupId>org.openjfx</groupId>
                        <artifactId>javafx-maven-plugin</artifactId>
                        <version>0.0.8</version>
                        <executions>
                            <execution>
                                <id>default-cli</id>
                                <configuration>
                                    <mainClass>org.application.desktop.MainApp</mainClass>
                                    <launcher>app</launcher>
                                    <jlinkZipName>app</jlinkZipName>
                                    <jlinkImageName>app</jlinkImageName>
                                    <noManPages>true</noManPages>
                                    <stripDebug>true</stripDebug>
                                    <noHeaderFiles>true</noHeaderFiles>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <version>0.10.6</version>
                        <configuration>
                            <imageName>application</imageName>
                            <mainClass>org.application.desktop.MainApp</mainClass>
                            <buildArgs>
                                <!-- تنظیمات اصلی -->
                                <buildArg>--no-fallback</buildArg>
                                <buildArg>--allow-incomplete-classpath</buildArg>
                                <buildArg>-H:+ReportExceptionStackTraces</buildArg>
                                <buildArg>-H:+ReportUnsupportedElementsAtRuntime</buildArg>

                                <!-- تنظیمات JavaFX -->
                                <buildArg>--initialize-at-run-time=com.sun.glass,com.sun.prism,com.sun.javafx</buildArg>
                                <buildArg>--initialize-at-build-time=javafx.graphics,javafx.controls,javafx.fxml,javafx.base</buildArg>
                                <buildArg>--initialize-at-run-time=com.sun.javafx.tk.quantum.QuantumToolkit</buildArg>
                                <buildArg>--initialize-at-run-time=com.sun.glass.ui.Application</buildArg>
                                <buildArg>--initialize-at-run-time=javafx.stage.Screen</buildArg>

                                <!-- تنظیمات منابع -->
                                <buildArg>-H:IncludeResources=.*\\.css</buildArg>
                                <buildArg>-H:IncludeResources=.*\\.bss</buildArg>
                                <buildArg>-H:IncludeResources=.*\\.fxml</buildArg>
                                <buildArg>-H:IncludeResources=.*\\.png</buildArg>

                                <!-- تنظیمات گرافیک -->
                                <buildArg>-Dprism.order=es2,sw</buildArg>
                                <buildArg>-Djava.awt.headless=false</buildArg>
                                <buildArg>-Dprism.verbose=true</buildArg>


                                <!-- تنظیمات reflection -->
                                <buildArg>-H:ReflectionConfigurationFiles=${project.basedir}/src/main/resources/config/reflection-config.json</buildArg>

                                <!-- تنظیمات Native Image -->
                                <buildArg>-H:+AllowVMInspection</buildArg>
                                <buildArg>-H:EnableURLProtocols=http,https</buildArg>
                                <buildArg>-H:NativeLinkerOption=-lgdi32</buildArg>
                                <buildArg>-H:NativeLinkerOption=-luser32</buildArg>
                            </buildArgs>
                        </configuration>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>build</goal>
                                </goals>
                                <phase>package</phase>
                            </execution>
                        </executions>
                    </plugin>


