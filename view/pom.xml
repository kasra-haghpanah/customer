                                <list>com/sun/javafx/scene/control/skin/resources/controls-nt</list>
                            </bundlesList>


                            <graalvmHome>C:\PC\Application\JAVA-APLICATIONS\GraalVM\graalvm-jdk-24.0.1+9.1</graalvmHome>
                        </configuration>
                    </plugin>

