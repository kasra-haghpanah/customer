    <build>
        <plugins>
            <!--
                         java &#45;&#45;module-path "C:/PC/Application/JAVA-APLICATIONS/javafx-sdk-21.0.2/lib" &#45;&#45;add-modules javafx.controls,javafx.fxml -jar application-1.0-SNAPSHOT-shaded.jar
-->

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <transformers>
                                <transformer
                                        implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>org.application.desktop.MainApp</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <archive>

                        <manifest> <!--نام کامل پکیج به همراه نام کلاس ک ه متد main در آن موجود است -->
                            <Main-Class>org.application.desktop.MainApp</Main-Class>
                            <addClasspath>true</addClasspath>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>


            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <id>run-with-agent</id>
                        <goals>
                            <goal>java</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <mainClass>org.application.desktop.MainApp</mainClass>
                    <arguments></arguments>
                    <systemProperties>
                        <systemProperty>
                            <key>java.library.path</key>
                            <value>${env.JAVA_HOME}/lib</value>
                        </systemProperty>
                    </systemProperties>
                    <commandlineArgs>
                        -agentlib:native-image-agent=config-merge-dir=src/main/resources/config1
                    </commandlineArgs>
                </configuration>
            </plugin>




            <!-- mvn javafx:run -->

            <!-- افزونه JavaFX برای اجرا -->

            <!-- mvn exec:exec -->  <!-- debug -->
            <!-- mvn exec:java -->  <!-- run -->

            <!-- netstat -an | find "5005" -->
            <!-- netstat -voa | find "5005" -->
            <!-- taskkill /PID 9304 /F -->


        </plugins>

        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <includes>
                    <include>**/*.properties</include>
                    <include>**/*.json</include>
                    <include>**/*.sql</include>
                </includes>
                <excludes>
                    <exclude>help/**</exclude>
                </excludes>
                <filtering>false</filtering>
            </resource>
        </resources>

