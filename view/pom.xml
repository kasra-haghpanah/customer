                                <arg>--initialize-at-run-time=com.sun.prism.sw.SWPipeline</arg>



                                <arg>--initialize-at-build-time=javafx</arg>

                                <arg>--enable-url-protocols=http,https</arg>


                                <arg>-H:IncludeResources=.*\.fxml$</arg>
