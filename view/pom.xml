                                <arg>-H:+UnlockExperimentalVMOptions</arg>



                                <arg>--initialize-at-build-time=com.sun.javafx</arg>

                                <arg>-H:CLibraryPath=${env.JAVA_HOME}/bin</arg> <!-- اضافه کردن این خط -->


