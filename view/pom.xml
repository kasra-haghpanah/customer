                    <value>jvm-release</value>
                </property>
            </activation>

            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-jlink-plugin</artifactId>
                        <version>3.2.0</version>
                        <configuration>
                            <launcher>myapp=org.application.desktop.MainApp
                            </launcher> <!-- نام اجراکننده و کلاس اصلی -->
                            <outputDirectory>${project.build.directory}/myapp-runtime
                            </outputDirectory> <!-- مسیر خروجی -->
                            <modulePaths>
                                <modulePath>${project.build.directory}/modules</modulePath>
                            </modulePaths>
                            <addModules>javafx.graphics,javafx.controls,javafx.base,javafx.fxml
                            </addModules> <!-- ماژول‌های مورد نیاز -->
                        </configuration>

                    </plugin>
                </plugins>
            </build>

        </profile>


