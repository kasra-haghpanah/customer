<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <parent>
    <artifactId>customer</artifactId>
    <groupId>org.application</groupId>
    <version>1.0-SNAPSHOT</version>
  </parent>
  <modelVersion>4.0.0</modelVersion>
  <artifactId>view</artifactId>
  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <includes>
          <include>**/*.properties</include>
          <include>**/*.json</include>
          <include>**/*.sql</include>
        </includes>
        <excludes>
          <exclude>help/**</exclude>
        </excludes>
      </resource>
    </resources>
    <finalName>${artifactId}</finalName>
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <source>${java.version}</source>
          <target>${java.version}</target>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.1</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <transformers>
                <transformer>
                  <mainClass>org.application.desktop.MainApp</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.3.0</version>
        <configuration>
          <archive>
            <manifest>
              <Main-Class>org.application.desktop.MainApp</Main-Class>
              <addClasspath>true</addClasspath>
            </manifest>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>run</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-maven-plugin</artifactId>
            <version>0.0.8</version>
            <executions>
              <execution>
                <id>create-reflection-config</id>
                <phase>process-classes</phase>
                <goals>
                  <goal>run</goal>
                </goals>
              </execution>
            </executions>
            <configuration>
              <mainClass>org.application.desktop.MainApp</mainClass>
              <options>
                <option>-agentlib:jdwp=transport=dt_socket,server=y,suspend=y,address=*:5005</option>
              </options>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>build</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-maven-plugin</artifactId>
            <version>0.0.8</version>
            <configuration>
              <mainClass>org.application.desktop.MainApp</mainClass>
              <options>
                <option>-agentlib:jdwp=transport=dt_socket,server=y,suspend=y,address=*:5005</option>
              </options>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>native-image</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.graalvm.buildtools</groupId>
            <artifactId>native-maven-plugin</artifactId>
            <version>0.10.6</version>
            <executions>
              <execution>
                <phase>package</phase>
                <goals>
                  <goal>build</goal>
                </goals>
              </execution>
            </executions>
            <configuration>
              <imageName>application</imageName>
              <mainClass>org.application.desktop.MainApp</mainClass>
              <buildArgs>
                <buildArg>--initialize-at-build-time=com.sun.javafx.logging.PlatformLogger</buildArg>
                <buildArg>--initialize-at-build-time=javafx.css</buildArg>
                <buildArg>--initialize-at-build-time=com.sun.javafx.css</buildArg>
                <buildArg>-H:IncludeResources=.*\\.css</buildArg>
                <buildArg>-H:IncludeResources=.*\\.bss</buildArg>
                <buildArg>--initialize-at-build-time=com.sun.scenario.animation.SplineInterpolator</buildArg>
                <buildArg>--initialize-at-build-time=com.sun.scenario.animation.StepInterpolator</buildArg>
                <buildArg>--verbose</buildArg>
                <buildArg>--diagnostics-mode</buildArg>
                <buildArg>--initialize-at-run-time=io.netty</buildArg>
                <buildArg>--initialize-at-run-time=org.slf4j</buildArg>
                <buildArg>-J-Xmx8G</buildArg>
                <buildArg>--enable-url-protocols=http,https</buildArg>
                <buildArg>--enable-native-access=ALL-UNNAMED</buildArg>
                <buildArg>-H:+ReportExceptionStackTraces</buildArg>
                <buildArg>-H:+PrintClassInitialization</buildArg>
                <buildArg>--no-fallback</buildArg>
                <buildArg>-H:+AddAllCharsets</buildArg>
                <buildArg>-H:+UnlockExperimentalVMOptions</buildArg>
                <buildArg>-H:ConfigurationFileDirectories=${project.basedir}/src/main/resources/config</buildArg>
                <buildArg>--initialize-at-run-time=javafx.scene.control.PopupControl</buildArg>
                <buildArg>--initialize-at-run-time=javafx.scene</buildArg>
                <buildArg>--initialize-at-run-time=javafx.scene.control</buildArg>
                <buildArg>--initialize-at-build-time=javafx.scene.image.Image$1</buildArg>
                <buildArg>--initialize-at-build-time=javafx.scene.input.KeyCodeCombination</buildArg>
                <buildArg>--initialize-at-build-time=javafx.scene.input.KeyCombination$Modifier</buildArg>
                <buildArg>--initialize-at-build-time=javafx.scene.input.KeyCode</buildArg>
                <buildArg>--initialize-at-build-time=javafx.scene.input.KeyCombination$ModifierValue</buildArg>
                <buildArg>--initialize-at-build-time=javafx.scene.input.KeyCombination$1</buildArg>
                <buildArg>--initialize-at-run-time=javafx.stage.Screen</buildArg>
                <buildArg>--initialize-at-run-time=com.sun.glass.ui.Application</buildArg>
                <buildArg>--initialize-at-run-time=com.sun.javafx.tk.quantum.QuantumToolkit</buildArg>
                <buildArg>--initialize-at-run-time=javafx.stage</buildArg>
                <buildArg>--initialize-at-run-time=javafx.graphics</buildArg>
                <buildArg>--initialize-at-run-time=javafx.scene.control.PopupControl$1</buildArg>
                <buildArg>--initialize-at-run-time=javafx.scene.control.PopupControl$2</buildArg>
                <buildArg>--initialize-at-build-time=javafx.graphics,javafx.controls,javafx.base,javafx.fxml</buildArg>
                <buildArg>--initialize-at-build-time=javafx.application.Platform</buildArg>
                <buildArg>--initialize-at-run-time=com.sun.prism.sw.SWPipeline</buildArg>
                <buildArg>--initialize-at-build-time=org.application.desktop.MainApp</buildArg>
                <buildArg>--initialize-at-build-time=javafx.application.Application</buildArg>
                <buildArg>--initialize-at-build-time=com.sun.javafx.application.PlatformImpl</buildArg>
                <buildArg>--initialize-at-run-time=com.sun.glass.ui</buildArg>
                <buildArg>--initialize-at-run-time=com.sun.javafx.tk.quantum</buildArg>
                <buildArg>--initialize-at-run-time=com.sun.prism.d3d.D3DPipeline</buildArg>
                <buildArg>--initialize-at-run-time=org.mariadb.jdbc.Driver</buildArg>
                <buildArg>--initialize-at-build-time=javafx.beans.property.SimpleBooleanProperty,javafx.beans.property,javafx.beans</buildArg>
                <buildArg>--trace-object-instantiation=java.lang.Thread</buildArg>
                <buildArg>--report-unsupported-elements-at-runtime</buildArg>
                <buildArg>--trace-object-instantiation=java.lang.Thread</buildArg>
                <buildArg>-Dprism.order=sw,d3d</buildArg>
                <buildArg>-H:IncludeResources=com/sun/prism/d3d/.*</buildArg>
                <buildArg>-H:IncludeResources=com/sun/prism/es2/.*</buildArg>
                <buildArg>-Djava.awt.headless=true</buildArg>
                <buildArg>-Dprism.verbose=true</buildArg>
                <buildArg>--allow-incomplete-classpath</buildArg>
                <buildArg>--initialize-at-build-time=com.sun.glass.ui</buildArg>
                <buildArg>--initialize-at-build-time=com.sun.javafx.tk</buildArg>
                <buildArg>--initialize-at-run-time=com.sun.javafx.tk.quantum.QuantumRenderer</buildArg>
                <buildArg>-H:IncludeResources=com/sun/javafx/font/.*</buildArg>
                <buildArg>-H:IncludeResources=com/sun/prism/.*</buildArg>
                <buildArg>-H:IncludeResources=com/sun/javafx/.*</buildArg>
                <buildArg>-H:IncludeResourceBundles=com.sun.prism</buildArg>
                <buildArg>-H:IncludeResourceBundles=com.sun.prism.resources.prism</buildArg>
                <buildArg>--initialize-at-build-time=com.sun.prism.sw</buildArg>
                <buildArg>--initialize-at-build-time=com.sun.javafx.tk.quantum</buildArg>
                <buildArg>--initialize-at-build-time=javafx</buildArg>
                <buildArg>-H:IncludeResources=.*fxml$</buildArg>
                <buildArg>-H:IncludeResources=.*css$</buildArg>
                <buildArg>-H:IncludeResources=.*png$</buildArg>
                <buildArg>-H:IncludeResourceBundles=com.sun.javafx.tk.quantum.QuantumMessagesBundle</buildArg>
              </buildArgs>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
  <repositories>
    <repository>
      <id>maven</id>
      <name>Maven-Central-Repository</name>
      <url>https://mvnrepository.com/artifact</url>
    </repository>
    <repository>
      <id>central</id>
      <name>Maven Central Repository</name>
      <url>https://repo.maven.apache.org/maven2</url>
    </repository>
    <repository>
      <id>openjfx</id>
      <url>https://nexus.gluonhq.com/nexus/content/repositories/releases/</url>
    </repository>
  </repositories>
  <dependencies>
    <dependency>
      <groupId>org.graalvm.sdk</groupId>
      <artifactId>graal-sdk</artifactId>
      <version>24.0.1</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>
  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <javafx.version>24.0.1</javafx.version>
    <java.version>24</java.version>
    <javafx.sdk>C:/PC/Application/JAVA-APLICATIONS/javafx-sdk-21.0.2</javafx.sdk>
  </properties>
</project>
