<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.kasra-haghpanah</groupId>
    <artifactId>customer</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <modules>
        <module>utility</module>
        <module>model</module>
        <module>repository</module>
        <module>service</module>
        <module>view</module>
    </modules>

    <properties>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <maria.version>3.5.3</maria.version>
        <hikari.version>6.3.0</hikari.version>


        <!-- Reproducible Build -->

        <!--
        after each release, it should be changed the timestamp

        linux: sha256sum target/customer-1.0.jar
        win: certutil -hashfile target\customer-1.0.jar SHA256
        -->
        <project.build.outputTimestamp>
            2026-07-01T00:00:00Z
        </project.build.outputTimestamp>
    </properties>


    <dependencyManagement>
        <dependencies>

            <dependency>
                <groupId>org.mariadb.jdbc</groupId>
                <artifactId>mariadb-java-client</artifactId>
                <version>${maria.version}</version>
            </dependency>

            <dependency>
                <groupId>com.zaxxer</groupId>
                <artifactId>HikariCP</artifactId>
                <version>${hikari.version}</version>
            </dependency>

            <dependency>
                <groupId>org.application</groupId>
                <artifactId>utility</artifactId>
                <version>${project.version}</version>
            </dependency>

        </dependencies>
    </dependencyManagement>


    <!-- to make release  -->
    <!--
    mvn versions:set "-DnewVersion=1.0.0" ->  Central Publishing Plugin(New)
    mvn clean deploy     ->  Central Publishing Plugin(New)


    mvn release:prepare  ->  maven-release-plugin(Old)
    mvn release:perform  ->  maven-release-plugin(Old)
    -->
    <!-- https://central.sonatype.com/?utm_source=chatgpt.com -->

    <name>customer</name>
    <description>Customer library</description>
    <url>https://github.com/kasra-haghpanah/customer</url>

    <licenses>
        <license>
            <name>Apache License 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>kasra-haghpanah</id>
            <name>Kasra Haghpanah</name>
            <email>kasrakhpk1985@gmail.com</email>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/kasra-haghpanah/customer.git</connection>
        <developerConnection>scm:git:https://github.com/kasra-haghpanah/customer.git</developerConnection>
        <url>https://github.com/kasra-haghpanah/customer</url>
        <tag>HEAD</tag>
<!--        <connection> scm:git:git://github.com/kasra-haghpanah/customer.git </connection>
        <developerConnection>scm:git:ssh://github.com/kasra-haghpanah/customer.git</developerConnection>
        <url> https://github.com/kasra-haghpanah/customer</url>
        <tag>HEAD</tag>-->
    </scm>


    <!--for maven-release-plugin-->

